DATABASE_URL=postgresql://usuario:senha@host:porta/banco
JWT_SECRET=sua_chave_secreta
RESEND_API_KEY=sua_chave_resend
MAIL_FROM=AdoteVL <noreply@seudominio.com>
APP_URL=http://localhost:5173
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
SUPABASE_STORAGE_BUCKET=pet-photos
# Bucket PRIVADO das fotos das fichas de adoção (padrão adoption-forms)
SUPABASE_ADOPTION_BUCKET=adoption-forms
# Opcional: "local" grava arquivos em ./uploads em vez do Supabase Storage (dev)
STORAGE_DRIVER=
# URL pública da API (usada nas URLs dos arquivos do storage local)
API_URL=http://localhost:3000
# Autentique (assinatura digital dos contratos). Token em https://painel.autentique.com.br/perfil/api
AUTENTIQUE_TOKEN=
# true = documentos de teste (não gastam créditos, somem após alguns dias)
AUTENTIQUE_SANDBOX=true
# Id da pasta do painel onde os termos são salvos (ex.: "Termos de adoção"); vazio = raiz
AUTENTIQUE_FOLDER_ID=
# Secret do webhook cadastrado no painel (POST /webhooks/autentique)
AUTENTIQUE_WEBHOOK_SECRET=
