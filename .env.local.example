# Ambiente local (copie para .env.local). Tem precedência sobre o .env.
DATABASE_URL=postgresql://adotevl:adotevl@localhost:5432/adotevl?sslmode=disable
# Obrigatório e aleatório, com 15+ caracteres (a API não sobe sem; valores de exemplo são recusados). Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
RESEND_API_KEY=re_fake_key_for_dev
MAIL_FROM=AdoteVL <onboarding@resend.dev>
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
# local = salva arquivos em ./uploads e serve em /uploads (sem Supabase)
STORAGE_DRIVER=local
# Autentique (assinatura digital dos contratos). Token em https://painel.autentique.com.br/perfil/api
AUTENTIQUE_TOKEN=
# true = documentos de teste (não gastam créditos, somem após alguns dias)
AUTENTIQUE_SANDBOX=true
# Id da pasta do painel onde os termos são salvos (ex.: "Termos de adoção"); vazio = raiz
AUTENTIQUE_FOLDER_ID=
# Secret do webhook cadastrado no painel (POST /webhooks/autentique)
AUTENTIQUE_WEBHOOK_SECRET=
